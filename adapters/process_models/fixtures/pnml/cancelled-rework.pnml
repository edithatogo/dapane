<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net_cancelled_rework" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <page id="p1">
      <place id="p_in"><initialMarking><text>1</text></initialMarking></place>
      <place id="p_qc"><initialMarking><text>0</text></initialMarking></place>
      <place id="p_complete"><initialMarking><text>0</text></initialMarking></place>
      <transition id="t_run"/>
      <transition id="t_repeat"/>
      <transition id="t_finish"/>
      <arc id="a1" source="p_in" target="t_run"/>
      <arc id="a2" source="t_run" target="p_qc"/>
      <arc id="a3" source="p_qc" target="t_repeat"/>
      <arc id="a4" source="t_repeat" target="p_in"/>
      <arc id="a5" source="p_qc" target="t_finish"/>
      <arc id="a6" source="t_finish" target="p_complete"/>
    </page>
  </net>
</pnml>
