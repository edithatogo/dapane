{
  "format": "dapane-uogto-contract-map/0.1",
  "dapane_source": "e34f87c9df39a2132fecee142431cdeefb732471",
  "uogto_source": "7e9075b8fd77543fc8853fab20319415cb86597d",
  "relation": "bounded representation references; never equivalence or redefinition",
  "rules": {
    "transport": {
      "terms": [],
      "disposition": "unmapped",
      "reason": "Dapane transport, lifecycle or calculation detail. Retained unchanged in embedded native JSON; no upstream assertion is inferred."
    },
    "native_numeric": {
      "terms": [],
      "disposition": "unmapped",
      "reason": "Native exact/rounded value or allocation detail. Per-generated-segment half-even and largest-remainder semantics remain authoritative; no decimal SHACL arithmetic replaces them."
    },
    "context": {
      "terms": [],
      "disposition": "unmapped",
      "reason": "Native context or many-to-many identity. A single UOGTO forCostObject/forActivity is not inferred from it."
    },
    "quantity": {
      "terms": [
        "quantity",
        "quantityExact"
      ],
      "disposition": "reference_only",
      "reason": "Decimal-string or exact-rational measurement remains native JSON. RDF numeric coercion is outside E2."
    },
    "quote_amount": {
      "terms": [
        "quoteAmount",
        "quoteAmountExact"
      ],
      "disposition": "reference_only",
      "reason": "Native amount retains per_quantity; no one-unit quote is inferred."
    },
    "basis": {
      "terms": [
        "valuationBasis"
      ],
      "disposition": "explicit_choice",
      "reason": "Require a compatible explicit basis. financial_cost does not distinguish expenditure/accounting; funding, tariff and payment stay separate."
    },
    "perspective": {
      "terms": [
        "hasPerspective"
      ],
      "disposition": "emitted",
      "reason": "Known upstream perspective or explicitly labelled local Perspective; no guessed synonym."
    },
    "currency": {
      "terms": [
        "currency"
      ],
      "disposition": "emitted_for_policy",
      "reason": "Policy currency without monetary conversion."
    },
    "year": {
      "terms": [
        "priceYear"
      ],
      "disposition": "emitted_for_policy",
      "reason": "Policy year as xsd:gYear; not source release or service date."
    },
    "version": {
      "terms": [
        "versionLabel"
      ],
      "disposition": "reference_only",
      "reason": "Original version string without verification claim."
    },
    "evidence": {
      "terms": [
        "evidenceStatus"
      ],
      "disposition": "preserved_declaration",
      "reason": "Original evidence label remains a caller declaration."
    },
    "access": {
      "terms": [
        "accessStatus"
      ],
      "disposition": "preserved_declaration",
      "reason": "Original accessibility stays distinct from validation."
    },
    "validation": {
      "terms": [
        "validationStatus"
      ],
      "disposition": "preserved_declaration",
      "reason": "Source status is never upgraded by SHACL/native replay."
    },
    "digest": {
      "terms": [
        "sourceDigest"
      ],
      "disposition": "reference_only",
      "reason": "Digest identifies declared bytes or canonical transport domain; not truth or authorship."
    },
    "numerator": {
      "terms": [
        "exactNumerator"
      ],
      "disposition": "reference_only",
      "reason": "Native integer strings retained; no float conversion."
    },
    "denominator": {
      "terms": [
        "exactDenominator"
      ],
      "disposition": "reference_only",
      "reason": "Native positive integer strings retained; no float conversion."
    }
  },
  "state_mappings": {
    "SourceRef.evidence": {
      "synthetic": "preserved; permitted candidate",
      "observed": "preserved natively; outside E2 export",
      "derived": "preserved natively; outside E2 export"
    },
    "SourceRef.access": {
      "public": "preserved; permitted candidate",
      "restricted": "outside E2 export",
      "private": "outside E2 export"
    },
    "SourceRef.validation": {
      "unvalidated": "preserved declaration",
      "source_verified": "preserved declaration; never exporter certification",
      "empirically_validated": "preserved declaration; never inferred from SHACL"
    },
    "ReportingAssertion": "Use applicability and assessmentStatus enumerations from pinned upstream SHACL directly.",
    "capacity_unknowns": "Native known/unknown and complete/partial states remain JSON; not reporting states.",
    "excluded_inputs": "excluded/missing/unsupported remain native exclusion states; no conversion to zeros or reporting judgements."
  },
