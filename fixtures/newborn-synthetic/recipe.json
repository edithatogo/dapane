  "composition": {
    "workforce": {
      "quote_ids": [
        "salary-quote",
        "oncost-quote"
      ],
      "same_use_components": [
        "salary",
        "oncost"
      ],
      "collection_minutes": "5",
      "confirmation_minutes": "15"
    },
    "laboratory_batch": {
      "quote_ids": [
        "transport-quote",
        "accession-qc-quote",
        "setup-quote",
        "controls-quote",
        "assay-material-quote",
        "programme-overhead-quote"
      ],
      "pool_policy": "full_pool_equal_participating_infant_weights",
      "quantity_per_batch_resource": "1",
      "primary_assays_per_specimen": 2
    },
    "repeat_collection": {
      "collection_minutes": "5",
      "incremental_quote_ids": [
        "repeat-transport-quote",
        "repeat-qc-quote"
      ],
      "retains_infant_and_episode": true,
      "new_attempt_specimen_card": true
    },
    "failed_assay_then_repeat": {
      "incremental_quote_ids": [
        "repeat-assay-quote"
      ],
      "retains_failed_cost_and_result": true,
      "new_assay_and_result": true
    },
    "reflex": {
      "staff_minutes": "3",
      "incremental_quote_ids": [
        "reflex-material-quote"
      ],
      "retains_specimen": true,
      "new_assay_and_result": true
    },
    "added_panel": {
      "incremental_quote_ids": [
        "added-panel-quote"
      ],
      "new_assay_per_specimen": true,
      "new_fixed_batch_cost": false
    },
    "instrument_capacity": {
      "unit": "instrument_hour",
      "observation_coverage": "incomplete",
      "allocation_profile": "0.2",
      "source_scenarios": "sources.json#capacity_scenarios",
      "availability_inferred_from_samples": false,
      "threshold_rule": "Prepared one-block and two-block scenarios; no runtime capacity planning.",
      "unallocated_meaning": "Unassigned source cost; not an idle-cost, waste, cash-saving or utilisation estimate."
    }
  },
  "perspectives": {
    "provider": {
      "family_time_included": false
    },
    "provider_plus_family": {
      "family_time_included": true,
      "family_minutes_per_participant": "30"
    }
  },
  "denominators": {
    "eligible_birth": {
      "unit": "distinct_infant",
      "membership_date": "birth_date"
    },
    "participating_infant": {
      "unit": "distinct_infant",
      "membership_date": "participation_date"
    },
    "valid_screen": {
      "unit": "distinct_infant",
      "membership_date": "valid_screen_date",
      "rule": "All explicitly selected final required results are valid."
    },
    "completed_pathway": {
      "unit": "distinct_infant",
      "membership_date": "completion_date"
    },
    "confirmed_diagnosis": {
      "unit": "distinct_infant",
      "membership_date": "confirmed_diagnosis_date"
    }
  },
  "denominator_policy": {
    "window": "half_open",
    "repeat_counting": "same_infant_once",
    "zero_denominator": "undefined_not_zero",
    "numerator": "entire_scenario_source_ledger_in_declared_perspective",
    "calculation_delivery": "independent_test_references_only; no new native reporting API"
  },
  "rounding": {
    "scale": 2,
    "mode": "half_even",
    "point_policy": "per_source_line_before_sum",
    "interval_policy": "existing_per_generated_segment_before_sum_unchanged"
  },
  "context_only_stages": {
    "reporting": "No additional resource quantities supplied in this bounded fixture.",
    "recall": "No additional resource quantities supplied in this bounded fixture.",
    "follow_up": "No additional resource quantities supplied in this bounded fixture."
  },
  "excluded_capabilities": [
    "Real provider recipe execution",
