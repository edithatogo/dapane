{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.2/request.schema.json",
  "title": "Dapane 0.2 request",
  "description": "Adds explicit incomplete instrument-capacity allocation; all full-pool allocation fields retain 0.1 meaning. Structural validation is not economic validation. Rust checks references, exclusivity, aggregate bounds and recorded use <= known capacity. Unallocated value is already in totals.unattributed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "run_id": {
      "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/request.schema.json#/properties/run_id"
    },
    "knowledge_cutoff": {
      "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/request.schema.json#/properties/knowledge_cutoff"
    },
    "policy": {
      "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/request.schema.json#/properties/policy"
    },
    "quotes": {
      "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/request.schema.json#/properties/quotes"
    },
    "usage": {
      "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/request.schema.json#/properties/usage"
    },
    "objects": {
      "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/request.schema.json#/properties/objects"
    },
    "processes": {
      "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/request.schema.json#/properties/processes"
    },
    "events": {
      "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/request.schema.json#/properties/events"
    },
    "object_relations": {
      "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/request.schema.json#/properties/object_relations"
    },
    "allocations": {
      "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/request.schema.json#/properties/allocations"
    },
    "capacity_allocations": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.2/common.schema.json#/$defs/capacityAllocation"
      },
      "minItems": 0,
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "knowledge_cutoff",
    "policy",
    "quotes",
    "usage"
  ]
}
