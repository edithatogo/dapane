{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/common.schema.json",
  "title": "Dapane 0.1 shared definitions",
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])\\S(?:.*\\S)?$",
      "description": "No surrounding whitespace or control characters. maxLength counts Unicode characters; Rust additionally enforces the authoritative 128-byte UTF-8 limit."
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "decimalString": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+$",
          "minLength": 1,
          "maxLength": 96
        },
        {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{1,36}$",
          "minLength": 3,
          "maxLength": 97
        }
      ],
      "description": "Unsigned exact decimal text: at most 96 total digits and 36 fractional digits; no exponent, sign, whitespace or JSON numeric literal."
    },
    "exactNumber": {
      "oneOf": [
        {
          "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/common.schema.json#/$defs/decimalString"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numerator": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "minLength": 1,
              "maxLength": 96
            },
            "denominator": {
              "type": "string",
              "pattern": "^0*[1-9][0-9]*$",
              "minLength": 1,
              "maxLength": 96
            }
          },
          "required": [
            "numerator",
            "denominator"
          ]
        }
      ]
    },
    "positiveExactNumber": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/common.schema.json#/$defs/exactNumber"
        },
        {
          "not": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^0+(?:\\.0+)?$"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "numerator": {
                    "type": "string",
                    "pattern": "^0+$"
                  },
                  "denominator": {
                    "type": "string",
                    "pattern": "^0*[1-9][0-9]*$",
                    "minLength": 1,
                    "maxLength": 96
                  }
                },
                "required": [
                  "numerator",
                  "denominator"
                ]
              }
            ]
          }
        }
      ]
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "maxLength": 1234
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 1234
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "description": "Canonical reduced nonnegative output rational. Reduction and the 4096-bit bound are enforced by Rust, not by this pattern."
    },
    "signedRational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(?:0|-?[1-9][0-9]*)$",
          "maxLength": 1235
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 1234
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "description": "Canonical reduced signed output rational for rounding adjustments."
    },
    "roundedAmount": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$",
      "description": "Nonnegative displayed amount; its exact number of fractional digits is governed by policy.rounding.scale and checked semantically."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "priceYear": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "kind": {
      "enum": [
        "resource_use",
        "activity_measure"
      ]
    },
    "basis": {
      "enum": [
        "economic_cost",
        "financial_cost",
        "funding",
        "charge"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/common.schema.json#/$defs/token"
        },
        "version": {
          "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/common.schema.json#/$defs/token"
        },
        "currency": {
          "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/common.schema.json#/$defs/currency"
        },
        "price_year": {
          "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/common.schema.json#/$defs/priceYear"
        },
        "perspective": {
          "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/common.schema.json#/$defs/token"
        },
        "basis": {
          "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/common.schema.json#/$defs/basis"
        },
        "rounding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "mode": {
              "const": "half_even"
            }
          },
          "required": [
            "scale",
            "mode"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "currency",
        "price_year",
        "perspective",
        "basis",
        "rounding"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/common.schema.json#/$defs/token"
        },
        "version": {
          "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/common.schema.json#/$defs/token"
        },
        "evidence": {
          "enum": [
            "synthetic",
            "observed",
            "derived"
          ]
        },
        "access": {
          "enum": [
            "public",
            "restricted",
            "private"
          ]
        },
        "validation": {
          "enum": [
            "unvalidated",
            "source_verified",
            "empirically_validated"
          ]
        },
        "content_digest": {
          "anyOf": [
            {
              "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/common.schema.json#/$defs/digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "locator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])\\S(?:.*\\S)?$",
              "description": "Locator text; need not be a network URI. Rust enforces 2048 UTF-8 bytes."
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "version",
        "evidence",
        "access",
        "validation"
      ],
      "description": "Caller declarations, not certificates or external evidence verification issued by Dapane."
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://raw.githubusercontent.com/edithatogo/dapane/main/schemas/0.1/common.schema.json#/$defs/token"
